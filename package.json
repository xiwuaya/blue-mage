{
  "name": "vue-project",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/update-date.js && node tools/update-methods.js && node tools/update-map-keys.js",
    "prerender": "vite build --ssr src/entry-server.ts --outDir dist-ssr && node tools/prerender.js",
    "build": "vue-tsc --noEmit && vite build && yarn prerender",
    "build:subpath": "yarn prebuild && vue-tsc --noEmit && vite build --base=/blue-mage/ && yarn prerender",
    "deploy": "yarn build:subpath && gh-pages -d dist",
    "preview": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "verify:hydration": "node tools/verify-hydration.mjs",
    "bench:party": "esbuild tools/bench-party-grouping.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/bench-party-grouping.cjs && node node_modules/.cache/bench-party-grouping.cjs",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@thewakingsands/eorzea-interactive-map": "^1.1.3",
    "@thewakingsands/kit-tooltip": "^0.4.0-beta.0",
    "leaflet": "^1.9.4",
    "vue": "~3.2.29"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.1.0",
    "@types/node": "^16.11.22",
    "@vitejs/plugin-vue": "^2.1.0",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^10.0.0",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "^8.5.0",
    "eslint-plugin-vue": "^8.2.0",
    "gh-pages": "^6.3.0",
    "playwright": "^1.64.0",
    "prettier": "^2.5.1",
    "typescript": "~4.5.5",
    "vite": "^2.7.13",
    "vue-tsc": "^0.31.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
